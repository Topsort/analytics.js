{
  "name": "@topsort/analytics.js",
  "version": "2.12.1",
  "description": "JS library to automatically report events to Topsort's Analytics",
  "main": "dist/ts.js",
  "type": "module",
  "repository": {
    "url": "https://github.com/Topsort/analytics.js"
  },
  "packageManager": "pnpm@10.22.0",
  "keywords": [
    "ads",
    "sponsored listings",
    "auctions",
    "analytics",
    "topsort"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/ts.mjs",
      "require": "./dist/ts.js"
    },
    "./iife": {
      "default": "./dist/ts.iife.js"
    }
  },
  "module": "./dist/ts.mjs",
  "files": [
    "dist/src",
    "dist/ts.js",
    "dist/ts.mjs",
    "dist/ts.iife.js",
    "dist/src/*.d.ts",
    "package.json",
    "README.md",
    "CHANGELOG.md"
  ],
  "homepage": "https://github.com/Topsort/analytics.js#readme",
  "scripts": {
    "build": "vite build && vite build --mode iife",
    "format": "biome format",
    "format:fix": "biome format --write",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "lint:ci": "biome ci",
    "prepack": "pnpm run build",
    "test": "vitest run --coverage",
    "test:e2e": "vite build && vite build -c vite.config.browser-test.js && tsc && node dist/mocks/api-server.js",
    "playground": "pnpm run build && npx serve .",
    "types:check": "tsc --noemit",
    "size": "size-limit"
  },
  "author": "Topsort",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@size-limit/file": "^14.0.0",
    "@types/express": "5.0.6",
    "@types/node": "25.9.9",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/typescript6": "^6.0.2",
    "@vitest/coverage-v8": "5.0.5",
    "express": "5.3.0",
    "jsdom": "30.1.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.4",
    "size-limit": "^14.0.0",
    "tslib": "2.8.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vite-plugin-dts": "5.1.2",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@topsort/sdk": "0.5.0"
  },
  "size-limit": [
    {
      "path": "dist/ts.iife.js",
      "limit": "4.5 kB"
    },
    {
      "path": "dist/ts.mjs",
      "limit": "4 kB"
    }
  ]
}
